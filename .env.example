AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FALLBACK_MODELS=gemini-flash-latest
PORT=3000
RATE_LIMIT_PER_MINUTE=20
AI_DAILY_LIMIT_PER_USER=25
AI_DAILY_GLOBAL_LIMIT=450
AI_CACHE_MINUTES=360

# --- Production only ---
# FORCE_HTTPS=1                       # redirect http -> https, enable HSTS
# TRUST_PROXY=1                       # set when behind a hosting proxy (Render, Railway, Nginx)
# ALLOWED_ORIGINS=https://hireready.in # extra domains allowed to call the API
